# Database Configuration
DB_PASSWORD=root123456

# JWT Secret (generate your own secure secret in production)
JWT_SECRET=paiswitch-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256

# AES Encryption Key (must be 32 characters)
AES_ENCRYPTION_KEY=paiswitch-aes-32-characters-key

# Optional: Anthropic API Key
ANTHROPIC_API_KEY=

# Optional frontend dev proxy target. If unset, the web app probes localhost:8080-8089
# and picks the PaiSwitch backend automatically.
VITE_API_PROXY_TARGET=http://localhost:8080
