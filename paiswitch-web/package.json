{
  "name": "paiswitch-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "dev:renderer": "vite",
    "build:renderer": "vue-tsc && vite build",
    "build:backend": "node scripts/build-desktop-backend.mjs",
    "tauri": "tauri",
    "desktop:dev": "npm run build:backend && tauri dev",
    "desktop:build": "npm run build:backend && LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 tauri build --bundles app,dmg",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@vueuse/core": "^10.7.2",
    "axios": "^1.6.5",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "5.4.5",
    "vite": "^5.0.11",
    "vue-tsc": "^1.8.27"
  }
}
